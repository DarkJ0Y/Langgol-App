# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Test output
coverage/
.vitest/

# Environment — NEVER commit real secrets
.env
.env.local
.env.*.local
# Every other .env variant, backups included. Switching a database URL invites a
# `cp .env .env.backup`, and that copy holds the same passwords the original does
# while matching none of the patterns above — one `git add -A` away from being
# published. Broad by intent; the exception below is what keeps the template.
.env.*
!.env.example

# Personal access tokens. This repository has had a `pat.txt` in its working directory more than
# once; a credential committed to history stays valid until it is revoked, not until it is deleted.
pat.txt
*.pat

# Vitest JSON report, written by CI to check that no suite silently skipped.
vitest-results.json


# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Prisma generated client
packages/db/generated/

# Local scratch
tmp/
scratch/
.neon

# Credential files kept beside the project. Never committed.
verceltoken.txt
pat.txt
*token*.txt
*.pat
