{
  "name": "langgol",
  "private": true,
  "version": "0.1.0",
  "description": "Langgol — digital operating system for the agricultural ecosystem of Bangladesh",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @langgol/db run generate",
    "db:migrate": "pnpm --filter @langgol/db run migrate",
    "db:seed": "pnpm --filter @langgol/db run seed",
    "db:validate": "pnpm --filter @langgol/db run validate",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate:deploy": "pnpm --filter @langgol/db run migrate:deploy",
    "e2e:marketplace": "tsx scripts/e2e-marketplace.ts",
    "seed:synthetic": "tsx scripts/seed-synthetic.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5",
    "@langgol/application": "workspace:*",
    "@langgol/db": "workspace:*",
    "@langgol/domain": "workspace:*",
    "@langgol/infrastructure": "workspace:*"
  }
}
