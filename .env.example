# ---------------------------------------------------------------------------
# Langgol environment. Copy to .env and fill in.
#
# NEVER commit a real .env. NEVER put a secret in a NEXT_PUBLIC_* variable —
# those are shipped to the browser, and CI fails the build if one looks secret.
# ---------------------------------------------------------------------------

# Deployment environment: development | test | staging | production
APP_ENV=development
NODE_ENV=development

# Public base URL of the web app.
APP_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# PostgreSQL 15+ WITH PostGIS. See docs/DEVELOPMENT.md for local options.
# DATABASE_URL goes through the pooler in production; DIRECT_URL bypasses it
# for migrations, which cannot run over a transaction pooler.
DATABASE_URL=postgresql://langgol:langgol@localhost:5432/langgol_dev
DIRECT_URL=postgresql://langgol:langgol@localhost:5432/langgol_dev

# --- Authentication -------------------------------------------------------
# development — sign in as one of a fixed set of fixture identities. No SMS, no
#               OTP, no provider credentials required. Unblocks engineering
#               before SMS infrastructure exists.
# otp         — the production mechanism: phone + one-time code over SMS.
#
# APP_ENV=production with anything other than AUTH_MODE=otp is a STARTUP
# FAILURE, not a permitted login. docs/03_ARCHITECTURE.md ADR-22
#
#   Local development   AUTH_MODE=development
#   Staging (OTP trial) AUTH_MODE=otp
#   Production          AUTH_MODE=otp   (enforced)
AUTH_MODE=development

# --- Sessions -------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-random-bytes-base64

# --- SMS ------------------------------------------------------------------
# console  — writes to the terminal (local only)
# memory   — captured in-process (tests only)
# http     — a real Bangladeshi SMS aggregator
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=LANGGOL
# Daily spend circuit breaker, in poisha. An SMS gateway without a cap is an
# open invoice to an attacker. docs/07_SECURITY.md §3.2
SMS_DAILY_BUDGET_POISHA=500000
SMS_UNIT_COST_POISHA=50

# --- Email ----------------------------------------------------------------
# Email is OPTIONAL to the platform: signup and login are by phone OTP, and no
# flow blocks on a verified address. docs/01_MVP_REQUIREMENTS.md §79
# none     — no email is sent at all; verification is simply unavailable
# console  — writes to the terminal (local only)
# memory   — captured in-process (tests only)
# http     — a transactional email vendor
EMAIL_PROVIDER=console
EMAIL_API_URL=
EMAIL_API_KEY=
# Quoted: the angle brackets are a shell redirect when this file is sourced, which is a
# documented workflow (docs/DEVELOPMENT.md). dotenv parsers strip the quotes.
EMAIL_FROM="Langgol <no-reply@langgol.app>"

# --- Observability --------------------------------------------------------
LOG_LEVEL=info
# Leave empty to disable remote error reporting.
ERROR_REPORTING_DSN=

# --- Internal jobs --------------------------------------------------------
# Shared secret for the scheduled-job endpoints. Not publicly reachable.
JOB_TRIGGER_SECRET=replace-me-in-every-environment

# --- Identity encryption (KYC) --------------------------------------------
# Protects national identity numbers at rest. Two independent subkeys are derived from it, one to
# encrypt and one to build the duplicate-detection index, so the cipher and the index never share
# key material.
#
# REQUIRED IN PRODUCTION — the application refuses to boot without it, because the alternative is
# a deployment where every KYC submission silently fails. Optional locally so that a developer
# working on the marketplace need not hold a production key; with it unset, identity submission is
# refused rather than storing anything in clear.
#
# Generate with:  openssl rand -base64 32
#
# Rotating it makes existing ciphertexts unreadable and existing duplicate indexes unmatchable.
# There is no re-encryption path yet, so treat rotation as a migration rather than a setting.
KYC_ENCRYPTION_KEY=

# --- Firebase -------------------------------------------------------------
# A connected SERVICE, not the system of record. PostgreSQL remains
# authoritative for money, inventory and the ledger — those invariants are
# enforced by database triggers and CHECK constraints that Firestore cannot
# express (docs/06_FINANCIAL_ARCHITECTURE.md §13).
#
# Used for: object storage of listing images, push notifications, analytics.
#
# Deliberately NOT NEXT_PUBLIC_*. A Firebase web apiKey is a public project
# identifier rather than a credential, but CI rejects any NEXT_PUBLIC_* name
# matching KEY/SECRET/TOKEN and that control is worth more than the shortcut.
# A server component passes the config to the client instead.
#
# Leave blank to run without Firebase — every adapter degrades to a no-op and
# says so, rather than failing at the first upload.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
