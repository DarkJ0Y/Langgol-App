{
  "name": "@langgol/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations and seed data for Langgol",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "format": "prisma format",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:check": "prisma migrate status",
    "verify:guarantees": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/checks/verify-database-guarantees.sql",
    "seed": "tsx prisma/seed/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:behaviour": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/checks/verify-database-behaviour.sql"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@langgol/domain": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
