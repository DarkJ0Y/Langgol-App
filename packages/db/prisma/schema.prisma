// Langgol database schema — Phase 1 foundation + Phase 2 marketplace core.
//
// Phase 1 provides identity and access, geography and addresses, versioned platform
// configuration, audit, notifications and idempotency.
//
// Phase 2 adds the marketplace loop specified in docs/02_DATABASE.md §5–8: profiles, the curated
// catalogue, listings with reservable inventory, the server-authoritative OrderQuote, and orders.
// The ledger, settlement, delivery trips and economic measurement remain future phases
// (docs/09_ROADMAP.md).
//
// Objects Prisma cannot express — CHECK constraints, append-only rules, PostGIS geography
// columns and their triggers, GIST indexes — live in hand-authored migrations alongside the
// generated ones. They are part of the security model, not a convenience.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- identity & access

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Every role the platform recognises. Mirrored by ROLES in packages/domain/src/identity/roles.ts,
/// which a test asserts, so the enum and the authorization vocabulary cannot drift apart.
///
/// Roles are an ENUM rather than rows because the authorization engine reasons about them at
/// compile time: RULES in policy.ts is an exhaustive Record<Action, Rule>, and that proof only
/// holds while the vocabulary is known to the compiler. Presentation lives in RoleDefinition.
enum Role {
  FARMER
  CONSUMER
  RETAILER
  OPS_AGENT
  ADMIN
  WHOLESALER
  SUPPLIER
  AGRICULTURAL_EXPERT
  LOGISTICS_PROVIDER
}

/// Recorded because agricultural programmes report on it and the pilot measures women's
/// participation. PREFER_NOT_TO_SAY is a real answer, distinct from a field never filled in.
enum Gender {
  FEMALE
  MALE
  OTHER
  PREFER_NOT_TO_SAY
}

/// How far through setup an account is — a separate axis from UserStatus. An ACTIVE account can
/// still be half-onboarded, and a SUSPENDED one can be fully set up.
/// How far through setup an account is.
///
/// Widened from four milestones to eight in P12. These states DESCRIBE progress and never grant
/// or withhold anything: a user at PHONE_VERIFIED can browse, order, list and be paid exactly as
/// one at FULLY_ONBOARDED can. Nothing in the platform branches on this value to decide whether an
/// action is permitted — that is the policy engine's job, and it reads roles and ownership.
///
/// The column is a cache of a derivation. `deriveOnboardingState` in
/// packages/domain/src/onboarding/states.ts computes it from what is true about the account right
/// now; storing it as well makes "how many users stalled after verifying their phone?" a question
/// SQL can answer.
///
/// FULLY_ONBOARDED includes the OPTIONAL identity check, so most healthy accounts will never
/// reach it. That is the intended reading, not an oversight.
enum OnboardingStatus {
  REGISTERED
  PHONE_VERIFIED
  ROLE_SELECTED
  PROFILE_STARTED
  PROFILE_COMPLETED
  KYC_PENDING
  KYC_VERIFIED
  FULLY_ONBOARDED
}

enum Language {
  BN
  EN
}

model User {
  id                   String           @id @default(uuid()) @db.Uuid
  /// E.164, always +8801XXXXXXXXX. The primary identifier: Bangladeshi users authenticate by phone.
  phone                String           @unique
  phoneVerifiedAt      DateTime?        @map("phone_verified_at")
  email                String?          @unique
  /// Set only by redeeming a token sent TO that address. Changing the address clears it, because
  /// the proof was about the old address and says nothing about the new one.
  emailVerifiedAt      DateTime?        @map("email_verified_at")
  fullName             String           @map("full_name")
  preferredLanguage    Language         @default(BN) @map("preferred_language")
  status               UserStatus       @default(ACTIVE)
  /// Setup progress. Defaults to REGISTERED so existing rows adopt a truthful value rather than
  /// being backfilled with a claim about work they may not have done.
  onboardingStatus     OnboardingStatus @default(REGISTERED) @map("onboarding_status")
  /// Object-storage key, not a URL: a URL expires and would be stale the moment it is stored.
  profilePhotoKey      String?          @map("profile_photo_key")
  /// Date only; no time component is meaningful and storing one invites timezone drift.
  dateOfBirth          DateTime?        @map("date_of_birth") @db.Date
  gender               Gender?
  lastLoginAt          DateTime?        @map("last_login_at")
  /// Development sign-in can authenticate ONLY these rows, and a CHECK constraint confines the
  /// flag to a reserved phone block. See the development_auth_fixtures migration.
  isDevelopmentFixture Boolean          @default(false) @map("is_development_fixture")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")

  roles     UserRoleAssignment[]
  sessions  Session[]
  addresses Address[]

  /// Role changes this account performed on OTHER accounts. Separate relations from `roles`,
  /// which is what this account holds. Both are RESTRICT at the database: an administrator's row
  /// cannot be hard-deleted while the record of what they granted or revoked still stands.
  rolesGranted UserRoleAssignment[] @relation("RoleGrantedBy")
  rolesRevoked UserRoleAssignment[] @relation("RoleRevokedBy")

  verificationTokens VerificationToken[]
  consents           ConsentRecord[]

  productionsBought Production[] @relation("ProductionBuyer")

  farmerProfile     FarmerProfile?
  consumerProfile   ConsumerProfile?
  retailerProfile   RetailerProfile?
  wholesalerProfile WholesalerProfile?
  supplierProfile   SupplierProfile?
  expertProfile     AgriculturalExpertProfile?
  logisticsProfile  LogisticsProviderProfile?

  verifications      Verification[]      @relation("VerificationSubject")
  verificationsGiven Verification[]      @relation("VerificationReviewer")
  verificationEvents VerificationEvent[] @relation("VerificationEventActor")
  identityRecord     IdentityRecord?
  agriIdentity       AgriIdentity?

  adminPermissions        AdminPermissionGrant[] @relation("AdminPermissionHolder")
  adminPermissionsGranted AdminPermissionGrant[] @relation("AdminPermissionGrantedBy")
  adminPermissionsRevoked AdminPermissionGrant[] @relation("AdminPermissionRevokedBy")

  @@index([status])
  @@index([onboardingStatus])
  @@map("users")
}

/// A user may hold several roles over time — a farmer who also buys is one account, not two.
model UserRoleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  role         Role
  grantedAt    DateTime  @default(now()) @map("granted_at")
  /// Null when self-selected at signup; set when an admin granted it.
  grantedById  String?   @map("granted_by_id") @db.Uuid
  revokedAt    DateTime? @map("revoked_at")
  /// Who took the role away, and why. A revocation can lock a farmer out of their own listings,
  /// so an unattributed one is not acceptable — the same principle as fault on a failed order.
  revokedById  String?   @map("revoked_by_id") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Attribution, not ownership. Cascade would delete an administrator's entire grant history
   * along with their account; SET NULL would breach `role_revocation_attributed`, which requires
   * a revoker whenever `revoked_at` is set. Restrict is the only option that keeps the record.
   */
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy User? @relation("RoleRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@unique([userId, role])
  @@index([role])
  @@index([grantedById])
  @@index([revokedById])
  @@map("user_role_assignments")
}

/// Presentation metadata for a Role. The enum is the identity; this table is the label.
///
/// Seeded from ROLE_CATALOGUE rather than created at runtime — a role an administrator could
/// invent would have no rule in the authorization engine, so it could be held but never checked.
/// `selfSelectable` is mirrored here for the signup screen, but the SERVER-side allowlist in
/// packages/domain/src/identity/roles.ts is the boundary; this column is a courtesy to the UI.
model RoleDefinition {
  role           Role     @id
  nameBn         String   @map("name_bn")
  nameEn         String   @map("name_en")
  descriptionBn  String   @map("description_bn")
  descriptionEn  String   @map("description_en")
  selfSelectable Boolean  @default(false) @map("self_selectable")
  privileged     Boolean  @default(false)
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("role_definitions")
}

/// Database-backed sessions: revocable, unlike a stateless JWT. docs/07_SECURITY.md §3.3
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  /// Stored as a SHA-256 hash. A leaked database must not yield usable session tokens.
  tokenHash    String    @unique @map("token_hash")
  userId       String    @map("user_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  revokedAt    DateTime? @map("revoked_at")
  revokedById  String?   @map("revoked_by_id") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

enum OtpPurpose {
  LOGIN
  /// A signed-in user proving the number on their account. Distinct from LOGIN so that verifying
  /// a number can never spend the rate-limit budget the same person needs in order to sign in.
  PHONE_VERIFY
  PHONE_CHANGE
  PAYOUT_CHANGE
  DELIVERY_CONFIRM
}

enum VerificationPurpose {
  EMAIL_VERIFY
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  LOCATION
  FARM_DATA
  FINANCIAL_DATA
  MARKETING
  PERSONALIZATION
  AI_DATA_PROCESSING
  TRANSACTION_DATA
}

/// Where a decision was taken. Deliberately has no ADMIN member: nobody may decide for someone
/// else, and the enum is the place that becomes impossible rather than a check that can be
/// forgotten. docs/07_SECURITY.md §9.2
enum ConsentSource {
  SIGNUP
  ACCOUNT_SETTINGS
  REPROMPT
}

/// One consent decision, append-only.
///
/// A row is never rewritten to flip an answer. Changing your mind supersedes the live row — its
/// `revoked_at` is stamped — and inserts a new one, so "what did this person agree to, when, and
/// to which version of the text?" stays answerable years later. That is the whole point: consent
/// that cannot be evidenced retrospectively is not consent, it is a checkbox.
///
/// `granted = false` is a RECORDED REFUSAL and is different from having no row at all. The
/// difference matters when someone asks whether they were ever shown the question.
model ConsentRecord {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  consentType ConsentType   @map("consent_type")
  granted     Boolean
  /// Which version of the document this answers. Compared against `consent.versions`; an
  /// agreement to an older version does not carry forward.
  version     Int
  grantedAt   DateTime      @map("granted_at")
  /// Set when this decision is superseded. The row itself is never deleted or edited.
  revokedAt   DateTime?     @map("revoked_at")
  source      ConsentSource
  /// Kept for legal defensibility, never returned by the API. docs/07 §9.2
  ipAddress   String?       @map("ip_address")
  userAgent   String?       @map("user_agent")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType, grantedAt])
  @@index([consentType, granted])
  @@map("consent_records")
}

/// A token emailed to an address to prove the recipient controls it.
///
/// Stored as a SHA-256 hash, never in plaintext — a leaked database must not yield redeemable
/// links. A fast hash is correct here and NOT an oversight: the token is 256 bits of CSPRNG
/// output, so there is no brute-force surface for a slow hash to defend, exactly as with session
/// tokens. The OTP table uses scrypt because six digits genuinely can be guessed.
model VerificationToken {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  purpose     VerificationPurpose
  /// The address the token was sent TO. Kept alongside the user so that redeeming a token can
  /// check the address has not changed since — a token proves control of an address, not of
  /// whatever address the account happens to hold when the link is finally clicked.
  destination String
  tokenHash   String              @unique @map("token_hash")
  expiresAt   DateTime            @map("expires_at")
  consumedAt  DateTime?           @map("consumed_at")
  /// Superseded by a newer request, or cancelled because the address changed.
  revokedAt   DateTime?           @map("revoked_at")
  requestIp   String?             @map("request_ip")
  createdAt   DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("verification_tokens")
}

/// Short-lived OTP challenge. The code is stored hashed and is never logged. docs/07_SECURITY.md §3.1
model OtpChallenge {
  id            String     @id @default(uuid()) @db.Uuid
  phone         String
  codeHash      String     @map("code_hash")
  purpose       OtpPurpose
  expiresAt     DateTime   @map("expires_at")
  attempts      Int        @default(0)
  maxAttempts   Int        @default(5) @map("max_attempts")
  consumedAt    DateTime?  @map("consumed_at")
  requestIp     String?    @map("request_ip")
  requestDevice String?    @map("request_device")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// ------------------------------------------------------------ geography & addresses

enum AdminAreaType {
  DIVISION
  DISTRICT
  UPAZILA
  UNION
}

enum LocationPrecision {
  EXACT
  APPROXIMATE
  AREA_CENTROID
}

/// Seeded reference data: 8 divisions → 64 districts → upazilas → unions.
///
/// This tree is the PRIMARY location model. Many rural addresses have no street address and no
/// reliable postcode; "village, union, upazila, near the school" is a complete address in
/// practice. The map pin is an enhancement. docs/08_BANGLADESH_CONTEXT.md §2
model AdminArea {
  id          String                                 @id @default(uuid()) @db.Uuid
  type        AdminAreaType
  parentId    String?                                @map("parent_id") @db.Uuid
  nameEn      String                                 @map("name_en")
  nameBn      String                                 @map("name_bn")
  /// Official statistical code where one is available.
  code        String?                                @unique
  centroidLat Decimal?                               @map("centroid_lat") @db.Decimal(9, 6)
  centroidLng Decimal?                               @map("centroid_lng") @db.Decimal(9, 6)
  /// Maintained by trigger from centroid_lat/lng. See the PostGIS migration.
  geo         Unsupported("geography(Point, 4326)")?
  isActive    Boolean                                @default(true) @map("is_active")
  createdAt   DateTime                               @default(now()) @map("created_at")

  parent              AdminArea?           @relation("AreaTree", fields: [parentId], references: [id])
  children            AdminArea[]          @relation("AreaTree")
  addresses           Address[]
  farms               Farm[]
  listings            Listing[]
  profileServiceAreas ProfileServiceArea[]

  @@index([type, parentId])
  @@index([parentId, nameEn])
  @@map("admin_areas")
}

model Address {
  id             String                                 @id @default(uuid()) @db.Uuid
  userId         String                                 @map("user_id") @db.Uuid
  label          String?
  recipientName  String                                 @map("recipient_name")
  recipientPhone String                                 @map("recipient_phone")
  /// ISO 3166-1 alpha-2. Bangladesh-only today; the column exists so an address carries its own
  /// country rather than depending on an assumption held elsewhere. The AdminArea tree is rooted
  /// at divisions, not a country node, because adding one would re-parent all eight for no gain.
  countryCode    String                                 @default("BD") @map("country_code")
  /// Union where known, otherwise upazila. Never null — the hierarchy is the address.
  adminAreaId    String                                 @map("admin_area_id") @db.Uuid
  villageOrArea  String?                                @map("village_or_area")
  addressLine    String                                 @map("address_line")
  /// Four digits where one exists. Optional on purpose: most rural addresses have no reliable
  /// postcode, and requiring one would reject the majority of this platform's users.
  postalCode     String?                                @map("postal_code")
  landmark       String?
  latitude       Decimal?                               @db.Decimal(9, 6)
  longitude      Decimal?                               @db.Decimal(9, 6)
  /// Records what we actually know, so distance-based pricing can widen its error bars
  /// honestly instead of implying metre accuracy from a union centroid.
  precision      LocationPrecision                      @default(AREA_CENTROID)
  /// Maintained by trigger from latitude/longitude. See the PostGIS migration.
  geo            Unsupported("geography(Point, 4326)")?
  isDefault      Boolean                                @default(false) @map("is_default")
  createdAt      DateTime                               @default(now()) @map("created_at")
  updatedAt      DateTime                               @updatedAt @map("updated_at")
  deletedAt      DateTime?                              @map("deleted_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        AdminArea           @relation(fields: [adminAreaId], references: [id])
  farms       Farm[]
  consumers   ConsumerProfile[]
  retailers   RetailerProfile[]
  wholesalers WholesalerProfile[]
  suppliers   SupplierProfile[]

  @@index([userId, isDefault])
  @@index([adminAreaId])
  /// Delivery corridors are planned per postcode where postcodes exist; without this the query
  /// is a sequential scan of every address on the platform.
  @@index([postalCode])
  @@map("addresses")
}

// ------------------------------------------------------------- platform configuration

/// Versioned business configuration: commission rate, delivery tariffs, funding models,
/// settlement policy, risk tiers, pilot budget, cancellation policy.
///
/// Never hard-coded. Every quote and order records the config version it was priced under, so
/// historical pricing stays reproducible years later. docs/03_ARCHITECTURE.md §7
model PlatformConfig {
  id            String   @id @default(uuid()) @db.Uuid
  key           String
  value         Json
  version       Int
  effectiveFrom DateTime @map("effective_from")
  note          String?
  updatedById   String?  @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([key, version])
  @@index([key, effectiveFrom])
  @@map("platform_configs")
}

// ------------------------------------------------------------------ audit & delivery

/// Append-only. Every privileged action, every state change that matters, every money movement.
/// Enforced immutable by database rule, not by policy. docs/07_SECURITY.md §10
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   Role?    @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  reason      String?
  requestId   String?  @map("request_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum NotificationChannel {
  SMS
  IN_APP
  EMAIL
  PUSH
  /// Reserved. Not implemented at MVP — see docs/03_ARCHITECTURE.md §8.1.
  IVR
  USSD
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String?             @map("user_id") @db.Uuid
  /// Denormalised destination so a notification remains auditable if the user record changes.
  destination String
  channel     NotificationChannel
  template    String
  locale      Language
  /// Template variables only. Never a rendered body containing personal data.
  payload     Json
  status      NotificationStatus  @default(QUEUED)
  providerRef String?             @map("provider_ref")
  error       String?
  attempts    Int                 @default(0)
  sentAt      DateTime?           @map("sent_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

/// Transactional outbox. Domain events are written in the same transaction as the state change
/// and dispatched asynchronously, so a state change is never lost because a gateway was down.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  processedAt   DateTime? @map("processed_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([processedAt, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Request-level idempotency for every state-changing command. Assume the connection drops
/// mid-request — on this network it will. docs/06_FINANCIAL_ARCHITECTURE.md §7
model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  scope          String
  key            String
  userId         String?   @map("user_id") @db.Uuid
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedAt       DateTime? @map("locked_at")
  completedAt    DateTime? @map("completed_at")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// =================================================================== PHASE 2 — MARKETPLACE
//
// docs/02_DATABASE.md §5–8. Money is BIGINT poisha with a `Poisha` suffix, quantity is BIGINT
// base units (milligrams for mass — §6.1). Constraints Prisma cannot express (CHECKs, the
// single-use quote guarantee, the atomic reservation rule) live in the accompanying migration
// and are part of the security model, not a convenience.

// ---------------------------------------------------------------------------- profiles

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum SettlementRail {
  AGENT_CASH
  MFS
  BANK
  REGULATED_PROVIDER
}

/// How somebody farms — six independent axes, mirrored by the vocabularies in
/// packages/domain/src/farming/catalogue.ts, which an integration test asserts against
/// `enum_range` so the two cannot drift apart.
///
/// Closed lists rather than free text for the same reason the product catalogue is curated
/// (§6.1): "সেচ আছে", "sech ache" and "irrigated" are one fact typed three ways, and free text
/// cannot be aggregated, translated, or matched against an advisory rule.

/// `MIXED` is the common answer, not the fallback: the smallholder norm is rice plus a homestead
/// vegetable plot plus a few birds. A list without it would force most farmers to misdescribe
/// themselves.
enum FarmerType {
  CROP
  VEGETABLE
  FRUIT
  FISH
  LIVESTOCK
  POULTRY
  DAIRY
  MIXED
}

/// The units a Bangladeshi farmer actually speaks. Nobody says "0.27 hectares"; they say
/// "দুই বিঘা". The unit is stored beside the number and converted in the domain, never in the
/// farmer's head. docs/08_BANGLADESH_CONTEXT.md §2
enum LandUnit {
  DECIMAL
  KATHA
  BIGHA
  ACRE
  HECTARE
}

/// Tenure, which matters well beyond bookkeeping: a sharecropper (বর্গা) does not control what is
/// planted and usually cannot pledge the crop, so credit and advisory features must be able to
/// tell them apart from an owner.
enum LandOwnershipType {
  OWNED
  LEASED
  SHARECROPPED
  MIXED
  COMMUNITY
}

/// How water reaches the field — deliberately separate from WHERE it comes from. The same pond
/// serves a bucket and a sprinkler, and those are different capital positions.
enum IrrigationMethod {
  MANUAL
  FLOOD
  FURROW
  SPRINKLER
  DRIP
}

enum WaterSource {
  RAIN
  RIVER
  CANAL
  POND
  SHALLOW_TUBEWELL
  DEEP_TUBEWELL
  SUPPLY
}

/// The farmer's OWN description of their practice. `ORGANIC` here is a self-declaration and must
/// never be surfaced to a buyer as a certified claim — that would turn an unverified answer into
/// a marketing assertion the platform cannot stand behind. Certification, if it is ever added,
/// is a separate field with evidence behind it.
/// Soil types a Bangladeshi farmer recognises, not a pedological classification.
///
/// The list is what an extension officer would ask and a farmer would answer. `SALINE` earns its
/// place separately from the texture classes because coastal salinity is a distinct problem with
/// distinct remedies, and it is spreading — a farmer in Khulna needs to be able to say it.
enum SoilType {
  LOAM
  CLAY
  CLAY_LOAM
  SANDY
  SANDY_LOAM
  SILT
  PEAT
  SALINE
}

enum FarmingMethod {
  CONVENTIONAL
  ORGANIC
  INTEGRATED
  MIXED
}

model FarmerProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  displayName        String             @map("display_name")
  bio                String?
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  /// Hash only — duplicate detection, never the number itself. docs/07_SECURITY.md §7
  nidHash            String?            @unique @map("nid_hash")
  settlementRail     SettlementRail     @default(AGENT_CASH) @map("settlement_rail")
  payoutAccountRef   String?            @map("payout_account_ref")
  payoutAccountName  String?            @map("payout_account_name")
  payoutVerifiedAt   DateTime?          @map("payout_verified_at")
  payoutChangedAt    DateTime?          @map("payout_changed_at")

  /// --- How they farm (P5) -------------------------------------------------------------
  ///
  /// EVERY field here is nullable, and that is the design. A farmer signing up on a borrowed
  /// phone at the edge of coverage must reach a working account; "has not answered the
  /// irrigation question yet" is not the same as "invalid". NID, payout details, GPS and email
  /// are separate systems with their own verification and none of them gates this profile.
  ///
  /// What the database DOES enforce is internal consistency — see the p5 migration's CHECK
  /// constraints. A profile may be incomplete; it may not be self-contradictory.
  farmingExperienceYears Int?               @map("farming_experience_years")
  farmerType             FarmerType?        @map("farmer_type")
  /// The farmer's own number, scaled by 1000 so "আড়াই বিঘা" survives as 2500 rather than as a
  /// float. Meaningless without `landUnit`, and a CHECK keeps the pair together.
  totalLandAmountMilli   Int?               @map("total_land_amount_milli")
  /// Kept rather than normalised away: a farmer who said "two bigha" and is shown "66 decimals"
  /// will reasonably conclude the record is wrong. Conversion happens on read, in the domain.
  landUnit               LandUnit?          @map("land_unit")
  ownershipType          LandOwnershipType? @map("ownership_type")
  irrigationAvailable    Boolean?           @map("irrigation_available")
  irrigationMethod       IrrigationMethod?  @map("irrigation_method")
  waterSource            WaterSource?       @map("water_source")
  farmingMethod          FarmingMethod?     @map("farming_method")

  /// NEW | STANDARD | TRUSTED — governs the hold between delivery and payout (D5, open Q2).
  riskTier                    String @default("NEW") @map("risk_tier")
  settlementHoldHoursOverride Int?   @map("settlement_hold_hours_override")

  /// Derived reputation. Recomputed from orders; never authoritative for money.
  ratingSumStarsMilli     Int @default(0) @map("rating_sum_stars_milli")
  ratingCount             Int @default(0) @map("rating_count")
  ordersAccepted          Int @default(0) @map("orders_accepted")
  ordersCompleted         Int @default(0) @map("orders_completed")
  ordersCancelledBySeller Int @default(0) @map("orders_cancelled_by_seller")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  farms       Farm[]
  listings    Listing[]
  productions Production[]

  @@index([verificationStatus])
  @@map("farmer_profiles")
}

model ConsumerProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  /// Where this shopper's orders go by default. A POINTER into the address book, never a copy:
  /// somebody who moves corrects one address and everything pointing at it follows.
  ///
  /// The foreign key proves the address exists; the trigger added alongside it proves the address
  /// is theirs. docs/07_SECURITY.md §4
  defaultAddressId String?  @map("default_address_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  /// --- What this shopper wants (P9) ----------------------------------------------------
  ///
  /// Deliberately NOT `preferred_language`: that lives on `users`, where every role has it, and
  /// a copy here would be a second answer to the same question.
  ///
  /// `dietaryPreferences` is about food, not identity. HALAL is recorded because it decides
  /// which listings are useful and for no other purpose. docs/07_SECURITY.md §7
  dietaryPreferences String[] @map("dietary_preferences")
  /// Free text: no curated list covers every crop somebody might ask for.
  preferredProducts  String[] @map("preferred_products")
  purchaseFrequency  String?  @map("purchase_frequency")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address? @relation(fields: [defaultAddressId], references: [id], onDelete: SetNull)

  @@index([defaultAddressId])
  @@map("consumer_profiles")
}

/// A retailer: buys from farmers and wholesalers, sells to the public.
///
/// ## Inventory, sales and purchases — where they will attach
///
/// P9 deliberately creates no table for any of the three. Two of them already have an owner, and
/// an empty table nobody writes is worse than no table: it invites a second, divergent answer to
/// a question that is already answered elsewhere.
///
///  - **Purchases** are `Order` rows where the retailer is the buyer. They exist today. A
///    retailer's purchase history is a query, not a new table, and P8 settled the precedent for
///    the whole codebase: derive it, never re-record it.
///  - **Sales** to the public are the one genuinely missing piece, because a walk-in customer
///    leaves no order behind. Whatever records them will hang off `RetailerProfile.id`, which is
///    why that id is stable and why this profile is a row rather than columns on `users`.
///  - **Inventory** is the join of the two and must be DERIVED from them, not maintained beside
///    them. A stock count kept as its own writable number drifts from the movements that produced
///    it, and once it has drifted there is no way to tell which one was right.
///
/// So the preparation here is the stable id, the address the stock sits at, and this note. The
/// schema change belongs to the phase that has the requirements.
model RetailerProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  businessName       String             @map("business_name")
  /// GROCERY | RESTAURANT | HOTEL | INSTITUTION
  businessType       String?            @map("business_type")
  tradeLicenceNumber String?            @map("trade_licence_number")
  /// VAT registration, for the tax hooks in docs/06 §10.
  binNumber          String?            @map("bin_number")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")

  /// --- P9 -------------------------------------------------------------------------------
  /// `tin` joins the `bin` that was already here. The two are constantly confused, so both are
  /// length-checked by one shared validator — see packages/domain/src/profiles/business.ts.
  tin             String?  @map("tin")
  yearsInBusiness Int?     @map("years_in_business")
  /// The shop's own address, and optionally its pin. Both optional: a street vendor has neither.
  addressId       String?  @map("address_id") @db.Uuid
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  updatedAt       DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  @@index([addressId])
  @@map("retailer_profiles")
}

/// A wholesaler: buys in bulk from farmers, distributes to retailers.
///
/// Shares its three business documents with the retailer and supplier profiles, validated by the
/// same module rather than three copies of the same regular expression.
model WholesalerProfile {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @unique @map("user_id") @db.Uuid
  businessName            String             @map("business_name")
  tradeLicence            String?            @map("trade_licence")
  tin                     String?
  bin                     String?
  /// Tonnes. A wholesaler thinks in tonnes of capacity, not kilograms.
  warehouseCapacityTonnes Int?               @map("warehouse_capacity_tonnes")
  /// Administrative reach rather than a radius, because that is how distribution is organised
  /// here — and the admin-area tree already models it.
  distributionReach       String?            @map("distribution_reach")
  ownsTransport           Boolean?           @map("owns_transport")
  addressId               String?            @map("address_id") @db.Uuid
  verificationStatus      VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  address     Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  serviceArea ProfileServiceArea[]

  @@map("wholesaler_profiles")
}

/// A supplier: sells INTO farming — seed, fertiliser, equipment. Not produce.
model SupplierProfile {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  companyName          String             @map("company_name")
  businessRegistration String?            @map("business_registration")
  tradeLicence         String?            @map("trade_licence")
  tin                  String?
  bin                  String?
  hasWarehouse         Boolean?           @map("has_warehouse")
  /// SEED | FERTILISER | PESTICIDE | EQUIPMENT | IRRIGATION | FEED | VETERINARY
  productCategories    String[]           @map("product_categories")
  addressId            String?            @map("address_id") @db.Uuid
  verificationStatus   VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  address     Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  serviceArea ProfileServiceArea[]

  @@map("supplier_profiles")
}

/// An agricultural expert: the human an AI diagnosis defers to.
///
/// `verificationStatus` matters more here than anywhere else on this list. An unverified
/// "expert" advising on pesticide dosage is the failure mode this whole role has to guard, which
/// is why the status is never settable from the profile form.
model AgriculturalExpertProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  /// AGRONOMY | PLANT_PATHOLOGY | ENTOMOLOGY | SOIL_SCIENCE | ...
  specialisations       String[]
  qualification         String?
  institution           String?
  yearsOfExperience     Int?     @map("years_of_experience")
  /// Free text: a certification is whatever the issuing body called it.
  certifications        String[]
  /// Integer poisha, like every other amount in the schema. Null means "not stated", which is
  /// different from a free consultation — that is zero.
  consultationFeePoisha BigInt?  @map("consultation_fee_poisha")
  offersOnline          Boolean? @map("offers_online")
  offersOffline         Boolean? @map("offers_offline")
  bio                   String?

  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceArea ProfileServiceArea[]

  @@index([verificationStatus])
  @@map("agricultural_expert_profiles")
}

/// A logistics provider: moves produce between the other roles.
model LogisticsProviderProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  companyName        String             @map("company_name")
  /// VAN | PICKUP | TRUCK | COVERED_VAN | REFRIGERATED_TRUCK | THREE_WHEELER | BOAT
  vehicleTypes       String[]           @map("vehicle_types")
  coldChainAvailable Boolean?           @map("cold_chain_available")
  warehouseAvailable Boolean?           @map("warehouse_available")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceArea ProfileServiceArea[]

  @@map("logistics_provider_profiles")
}

/// Where a business operates.
///
/// A join onto the admin-area tree rather than a text column, because "where do you serve?" is
/// answered with a list of upazilas and districts — which the tree already models, and which a
/// free-text field could never be searched against.
///
/// One table for four roles rather than four join tables. Exactly one of the four foreign keys is
/// set on any row, enforced by a CHECK in the p9 migration: a service area belongs to one profile
/// or it belongs to nothing.
model ProfileServiceArea {
  id          String @id @default(uuid()) @db.Uuid
  adminAreaId String @map("admin_area_id") @db.Uuid

  wholesalerProfileId String? @map("wholesaler_profile_id") @db.Uuid
  supplierProfileId   String? @map("supplier_profile_id") @db.Uuid
  expertProfileId     String? @map("expert_profile_id") @db.Uuid
  logisticsProfileId  String? @map("logistics_profile_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  area       AdminArea                  @relation(fields: [adminAreaId], references: [id])
  wholesaler WholesalerProfile?         @relation(fields: [wholesalerProfileId], references: [id], onDelete: Cascade)
  supplier   SupplierProfile?           @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  expert     AgriculturalExpertProfile? @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  logistics  LogisticsProviderProfile?  @relation(fields: [logisticsProfileId], references: [id], onDelete: Cascade)

  @@index([adminAreaId])
  @@index([wholesalerProfileId])
  @@index([supplierProfileId])
  @@index([expertProfileId])
  @@index([logisticsProfileId])
  @@map("profile_service_areas")
}

// ------------------------------------------------------------ admin permissions

/// What an administrator may actually do.
///
/// The ADMIN role is a door; this is the key. Before P13, holding the role meant holding
/// everything — reading any user, granting any role, decrypting any national identity number — so
/// one compromised session was total loss. Now the role admits somebody to the back office and
/// grants nothing inside it.
///
/// There is deliberately no wildcard value and no super-permission. An administrator with no rows
/// here can open the dashboard and do nothing from it, which is the correct state for an account
/// created five minutes ago.
enum AdminPermission {
  USER_VIEW
  USER_EDIT
  ROLE_MANAGE
  KYC_VIEW
  KYC_REVIEW
  BUSINESS_REVIEW
  FARM_REVIEW
  EXPERT_REVIEW
  AUDIT_VIEW
  ACCOUNT_SUSPEND
}

/// One permission held by one administrator.
///
/// Shaped like `UserRoleAssignment` rather than as an array column on `users`, and for the same
/// reasons: a grant has a granter, a moment and a reason, and taking one away is an event worth
/// recording rather than an array element quietly disappearing.
///
/// Revocation is a timestamp, not a delete. "Who could decrypt identity numbers last March?" is a
/// question an incident review will ask, and a row that was removed cannot answer it.
model AdminPermissionGrant {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  permission AdminPermission

  grantedAt   DateTime @default(now()) @map("granted_at")
  grantedById String   @map("granted_by_id") @db.Uuid

  /// Null while the grant is live. Set, never deleted.
  revokedAt    DateTime? @map("revoked_at")
  revokedById  String?   @map("revoked_by_id") @db.Uuid
  /// Why it was taken away. An unattributed revocation of a permission somebody needed to do their
  /// job is the kind of thing nobody can explain a month later.
  revokeReason String?   @map("revoke_reason")

  createdAt DateTime @default(now()) @map("created_at")

  user      User  @relation("AdminPermissionHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User  @relation("AdminPermissionGrantedBy", fields: [grantedById], references: [id])
  revokedBy User? @relation("AdminPermissionRevokedBy", fields: [revokedById], references: [id])

  @@index([userId, revokedAt])
  @@map("admin_permission_grants")
}

// --------------------------------------------------- digital agricultural identity

/// The public name a person carries in the agricultural economy.
///
/// `AGRI-BD-7K4M2QX9`. It goes on a certificate, a delivery note, a cooperative register and,
/// later, a loan application, so it is designed to be printed, spoken and typed back.
///
/// ## The value is random and derived from nothing
///
/// Not a hash of the user id, the NID or the phone number. A national ID has few enough plausible
/// values that a hashed one could be enumerated offline by anybody holding the identifier, which
/// would turn a public name into a disclosure of the most private field in the system. The body is
/// CSPRNG output; there is nothing to invert because there is no function.
/// See packages/domain/src/agri-identity/agri-id.ts.
///
/// ## It is an identifier, never a credential
///
/// Knowing somebody AGRI-ID must grant no access, exactly as knowing their name does not. There is
/// no lookup-by-AGRI-ID in the policy vocabulary, so the guarantee is an absent capability rather
/// than a check somebody could forget.
///
/// ## Why its own table
///
/// A column on `users` would work today and would be the wrong shape tomorrow. Credit,
/// traceability, insurance, government programmes and certificates all attach to the AGRI-ID
/// rather than to a user id, and they attach to a row that has its own lifecycle, its own issue
/// date and its own future columns.
model AgriIdentity {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// UNIQUE, and enforced by the database rather than by a read-then-write check: two people
  /// sharing an AGRI-ID is not a state this system could recover from once either has printed it.
  agriId String @unique @map("agri_id")

  /// Present from the first identifier rather than retrofitted. A country cannot be added later to
  /// something already printed on paper.
  countryCode String @default("BD") @map("country_code")

  /// When the name came into existence. A dispute or a support conversation may need to establish
  /// it, and `created_at` alone would be overwritten by any future re-issue mechanism.
  issuedAt DateTime @default(now()) @map("issued_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agri_identities")
}

// ------------------------------------------------------- identity, KYC and verification

/// What is being verified.
///
/// PHONE and EMAIL are here even though they are proven automatically, because "what is proven
/// about this account?" should have one answer rather than two places to look.
enum KycVerificationType {
  PHONE
  EMAIL
  IDENTITY
  FARM
  BUSINESS
  EXPERT
  PAYMENT
}

/// Where a verification stands.
///
/// Distinct from `VerificationStatus`, which is the coarse UNVERIFIED/PENDING/VERIFIED/REJECTED
/// flag carried by the role profiles. This one is the workflow: PENDING and UNDER_REVIEW are
/// separate so an ageing queue can be told apart from a busy one, and EXPIRED is separate from
/// REJECTED because a lapsed document was never judged false.
enum KycStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

/// How the evidence was checked. Recorded so a decision can be understood a year later.
enum KycMethod {
  MANUAL_REVIEW
  AUTOMATED_CHALLENGE
  GOVERNMENT_REGISTRY
  FIELD_AGENT
}

/// Which document. Only NID is submittable today; the rest are named so that widening support is
/// a change to an application allowlist rather than a migration that rewrites stored values.
enum IdentityDocumentType {
  NID
  BIRTH_CERTIFICATE
  PASSPORT
  DRIVING_LICENCE
}

/// One verification, of one kind, for one user.
///
/// The hub of the whole feature. Seven types share this row rather than growing seven tables,
/// because "somebody submitted evidence, somebody qualified looked at it, and here is what they
/// decided and when" is one problem — and solving it seven times is how the seventh ends up with
/// no audit trail.
///
/// `status` is never writable by the subject. The transition table in
/// packages/domain/src/kyc/verification.ts has no edge reaching VERIFIED with a SUBJECT actor,
/// and the policy vocabulary has no action that would let one. docs/07_SECURITY.md 4
model Verification {
  id     String              @id @default(uuid()) @db.Uuid
  userId String              @map("user_id") @db.Uuid
  type   KycVerificationType
  status KycStatus           @default(PENDING)
  method KycMethod?

  submittedAt    DateTime? @map("submitted_at")
  reviewedAt     DateTime? @map("reviewed_at")
  reviewerUserId String?   @map("reviewer_user_id") @db.Uuid

  /// Why it was refused, in words the submitter can act on. Never null on a REJECTED row  a
  /// CHECK in the migration enforces that, because "rejected" with no reason means the person
  /// re-submits the same thing and occupies the queue twice.
  rejectionReason String? @map("rejection_reason")

  /// When a VERIFIED record stops counting. Null means it does not lapse.
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User                @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?               @relation("VerificationReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  identity IdentityRecord?
  events   VerificationEvent[]

  /// One verification of each kind per user. Two taps on a slow connection must produce one row
  /// in the reviewer queue, and the database is the only participant that can guarantee that.
  @@unique([userId, type])
  /// The queue: pending work, oldest first.
  @@index([status, submittedAt])
  @@index([userId])
  @@index([reviewerUserId])
  @@map("verifications")
}

/// The identity document behind an IDENTITY verification.
///
/// Split from `Verification` because these columns are the sensitive ones and nothing else needs
/// them. A join is required to reach a ciphertext, which means the ordinary queue and status
/// reads  which do not join  cannot leak one by accident.
///
/// ## Why the number is encrypted rather than hashed
///
/// A reviewer has to READ it to compare against the card. And an NID has too little entropy for
/// a hash to protect it: the whole space is enumerable, so a hashed column would be reversible
/// by anyone who obtained it. AES-256-GCM under a key held outside the database, bound to the
/// owning user so a ciphertext cannot be moved between rows.
/// See packages/infrastructure/src/crypto/encryption.ts.
model IdentityRecord {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @unique @map("user_id") @db.Uuid
  verificationId String @unique @map("verification_id") @db.Uuid

  identityType IdentityDocumentType @map("identity_type")

  /// AES-256-GCM. Never selected by any ordinary read path  see the repository, where reaching
  /// it requires calling a method named `revealCiphertext`.
  identityNumberCiphertext String @map("identity_number_ciphertext")

  /// A keyed HMAC of the number, so "is this document already registered?" is answerable without
  /// decrypting the table. Unique across users: one card must not verify several accounts.
  identityNumberBlindIndex String @unique @map("identity_number_blind_index")

  /// What a screen shows. Stored already masked so that rendering never needs a decryption, and
  /// a read path that never decrypts is a read path that cannot leak.
  identityNumberMasked String @map("identity_number_masked")

  /// The trailing digits, kept in clear so a mask can be rebuilt. Four digits identifies nobody.
  identityNumberLast4 String @map("identity_number_last4")

  /// Object storage keys, never URLs. These objects have no public path; they are streamed by an
  /// authorized route against a short-lived signed grant. docs/07_SECURITY.md 7
  documentFrontKey String  @map("document_front_key")
  documentBackKey  String? @map("document_back_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("identity_records")
}

/// Every state change, append-only.
///
/// "See verification history" in the requirements, and the evidence an auditor needs: who
/// decided, when, from what to what, and why. Append-only by trigger rather than by convention
/// a history a reviewer can edit is not a history.
///
/// `reason` may hold a rejection reason, which is written by a reviewer about a document. It must
/// never hold an identity number, and the use case that writes these rows passes only the
/// reviewer own words. docs/07_SECURITY.md 11
model VerificationEvent {
  id             String @id @default(uuid()) @db.Uuid
  verificationId String @map("verification_id") @db.Uuid

  /// Null for a system transition such as expiry, which no person caused.
  actorUserId String? @map("actor_user_id") @db.Uuid

  action     String
  fromStatus KycStatus? @map("from_status")
  toStatus   KycStatus  @map("to_status")
  reason     String?

  createdAt DateTime @default(now()) @map("created_at")

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("VerificationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([verificationId, createdAt])
  @@map("verification_events")
}

// ------------------------------------------------------------- farms & curated catalogue

enum BaseUnit {
  MILLIGRAM
  MILLILITRE
  PIECE
}

enum SaleUnit {
  MILLIGRAM
  GRAM
  KG
  SEER
  MON
  TONNE
  MILLILITRE
  LITRE
  PIECE
  HALI
  DOZEN
}

enum PerishabilityClass {
  HIGHLY_PERISHABLE
  PERISHABLE
  SEMI_DURABLE
  DURABLE
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  SOLD_OUT
  EXPIRED
  REMOVED
}

enum QualityGrade {
  A
  B
  C
  UNGRADED
}

model Farm {
  id              String                                   @id @default(uuid()) @db.Uuid
  farmerProfileId String                                   @map("farmer_profile_id") @db.Uuid
  name            String
  adminAreaId     String                                   @map("admin_area_id") @db.Uuid
  villageOrArea   String?                                  @map("village_or_area")
  addressLine     String?                                  @map("address_line")
  latitude        Decimal?                                 @db.Decimal(9, 6)
  longitude       Decimal?                                 @db.Decimal(9, 6)
  precision       LocationPrecision                        @default(AREA_CENTROID)
  /// Maintained by trigger from latitude/longitude. See the p2_marketplace_core migration.
  geo             Unsupported("geography(Point, 4326)")?
  /// Field boundary, for a future mapping surface. Nothing writes this yet; the column and its
  /// GIST index exist so that when something does, it is not a schema change on a hot table.
  /// `packages/domain/src/location/boundary.ts` owns ring validation and the lon/lat ordering.
  boundary        Unsupported("geography(Polygon, 4326)")?
  createdAt       DateTime                                 @default(now()) @map("created_at")
  updatedAt       DateTime                                 @updatedAt @map("updated_at")
  deletedAt       DateTime?                                @map("deleted_at")

  /// --- This farm's own description (P6) -------------------------------------------------
  ///
  /// Deliberately the same shape as the P5 farmer profile, and deliberately separate from it.
  /// The profile says how somebody farms in general; these say what is true of THIS holding. A
  /// farmer with an irrigated vegetable plot near the house and a rain-fed rice field an hour
  /// away is the ordinary case, and one set of answers cannot describe both.
  ///
  /// Every field is nullable for the same reason as P5: an incomplete farm is a farm.
  ///
  /// Replaces `land_area_decimals`, which was added in P2, never read or written by any code,
  /// and could not record the unit the farmer actually used. See the p6 migration.
  areaAmountMilli     Int?               @map("area_amount_milli")
  areaUnit            LandUnit?          @map("area_unit")
  ownershipType       LandOwnershipType? @map("ownership_type")
  soilType            SoilType?          @map("soil_type")
  irrigationAvailable Boolean?           @map("irrigation_available")
  irrigationMethod    IrrigationMethod?  @map("irrigation_method")
  waterSource         WaterSource?       @map("water_source")
  farmingMethod       FarmingMethod?     @map("farming_method")
  verificationStatus  VerificationStatus @default(UNVERIFIED) @map("verification_status")

  /// Optional delivery/correspondence address for this farm.
  ///
  /// Nullable because a farm is located by its `adminAreaId` and optional pin — an address is a
  /// convenience, not the location. A trigger checks the address belongs to the same user as the
  /// farm, because a foreign key alone would happily let one farmer point at another's address.
  addressId String? @map("address_id") @db.Uuid

  farmer      FarmerProfile @relation(fields: [farmerProfileId], references: [id])
  area        AdminArea     @relation(fields: [adminAreaId], references: [id])
  productions Production[]
  address     Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull)
  listings    Listing[]
  plots       Plot[]

  @@index([farmerProfileId])
  @@index([adminAreaId])
  @@index([addressId])
  @@map("farms")
}

/// A named piece of a farm.
///
/// One level below `Farm` and no further: a farmer talks about "the north field" or "the pond
/// side", not about a tree of sub-parcels. Nesting plots inside plots would buy generality nobody
/// asked for and make every ownership query recursive — which is exactly where IDOR bugs live.
///
/// A plot inherits its farm's location and answers unless it overrides them. That is why every
/// descriptive column here is nullable: `null` means "same as the farm", not "unknown".
model Plot {
  id     String @id @default(uuid()) @db.Uuid
  farmId String @map("farm_id") @db.Uuid
  name   String

  areaAmountMilli  Int?              @map("area_amount_milli")
  areaUnit         LandUnit?         @map("area_unit")
  soilType         SoilType?         @map("soil_type")
  irrigationMethod IrrigationMethod? @map("irrigation_method")

  /// Optional, like every other pin in Langgol. A plot without coordinates is a complete plot.
  latitude  Decimal?                                 @db.Decimal(9, 6)
  longitude Decimal?                                 @db.Decimal(9, 6)
  /// Maintained by trigger from latitude/longitude, mirroring farms and addresses.
  geo       Unsupported("geography(Point, 4326)")?
  /// The boundary a farmer will one day draw on a map. Nothing writes it yet — the column and
  /// its GIST index exist so that adding the mapping surface is not a schema change on a table
  /// that by then holds every plot in the pilot.
  boundary  Unsupported("geography(Polygon, 4326)")?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft, because a plot may be referenced by a harvest or listing record later.
  deletedAt DateTime? @map("deleted_at")

  farm        Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  productions Production[]

  @@index([farmId])
  @@map("plots")
}

/// The seasons a Bangladeshi farmer names.
///
/// Two overlapping vocabularies, both in daily use: BORO/AUS/AMAN are the three rice seasons
/// everyone names, RABI and KHARIF the general winter and monsoon seasons used for everything
/// else. Forcing rice into "Kharif-2" would be tidy and would produce a form no farmer
/// recognises. Mirrored by SEASONS in packages/domain/src/production/production.ts.
enum Season {
  BORO
  AUS
  AMAN
  RABI
  KHARIF
  YEAR_ROUND
}

/// What a farmer actually harvested and sold, one record per crop per plot per season.
///
/// This is the history yield prediction, forecasting, credit scoring and price prediction will
/// all read from, which places one obligation above the rest: nothing here may be invented.
/// Every column is either something the farmer stated or something derived from what they stated
/// — never a default standing in for an answer they did not give.
///
/// `revenue_poisha` is DERIVED and a trigger overwrites whatever is submitted. A farmer may say
/// what they sold and what they were paid; the product of the two is not theirs to state, because
/// a stored revenue that disagrees with its own inputs is unfalsifiable later and a credit score
/// built on it would be scoring a typo. See the p8 migration.
model Production {
  id              String  @id @default(uuid()) @db.Uuid
  farmerProfileId String  @map("farmer_profile_id") @db.Uuid
  farmId          String  @map("farm_id") @db.Uuid
  /// Nullable: a farmer may record a harvest for a whole farm without having split it into plots.
  plotId          String? @map("plot_id") @db.Uuid
  /// The curated catalogue entry — the same `Product` the marketplace lists, deliberately, so a
  /// cultivation history and a listing describe the same crop rather than two unjoinable names.
  productId       String? @map("product_id") @db.Uuid
  varietyId       String? @map("variety_id") @db.Uuid

  season Season?
  year   Int?

  /// The farmer's own number and unit, never normalised away. Same pair rule as everywhere else.
  cultivatedAreaMilli Int?      @map("cultivated_area_milli")
  cultivatedAreaUnit  LandUnit? @map("cultivated_area_unit")

  /// Base units (milligrams for mass), like every other quantity in the schema.
  productionQuantityBase BigInt?   @map("production_quantity_base")
  productionUnit         SaleUnit? @map("production_unit")

  /// Integer poisha throughout. `selling_price_poisha` is per SALE unit — "forty taka a kilo" is
  /// what a farmer says — not per base unit.
  productionCostPoisha BigInt? @map("production_cost_poisha")
  sellingQuantityBase  BigInt? @map("selling_quantity_base")
  sellingPricePoisha   BigInt? @map("selling_price_poisha")

  /// DERIVED. Written only by `productions_derive_revenue`; anything an application sends is
  /// discarded. Stored rather than computed on read so analytics can aggregate it in SQL.
  revenuePoisha BigInt? @map("revenue_poisha")

  /// Who bought it, when the sale happened on Langgol. Null for a sale made at the local market,
  /// which is most of them today and is a fact worth recording rather than hiding.
  buyerUserId String? @map("buyer_user_id") @db.Uuid

  harvestDate DateTime? @map("harvest_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  farmer  FarmerProfile   @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  farm    Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plot    Plot?           @relation(fields: [plotId], references: [id], onDelete: SetNull)
  product Product?        @relation(fields: [productId], references: [id])
  variety ProductVariety? @relation(fields: [varietyId], references: [id])
  buyer   User?           @relation("ProductionBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)

  /// The indexes the required filters need: by crop, by year, by season.
  @@index([farmerProfileId, year])
  @@index([farmerProfileId, productId])
  @@index([farmerProfileId, season, year])
  @@index([farmId])
  @@index([plotId])
  @@map("productions")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  nameEn    String    @map("name_en")
  nameBn    String    @map("name_bn")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  products  Product[]

  @@map("product_categories")
}

/// Curated catalogue. Farmers pick from it; they do not invent free-text products.
///
/// Free text destroys search, makes listings incomparable, and breaks the delivered-cost engine,
/// which needs perishability and shelf life to model spoilage. docs/02_DATABASE.md §6.1
model Product {
  id                    String             @id @default(uuid()) @db.Uuid
  categoryId            String             @map("category_id") @db.Uuid
  slug                  String             @unique
  nameEn                String             @map("name_en")
  nameBn                String             @map("name_bn")
  /// Transliteration-tolerant search terms: "tomato", "টমেটো", "tometo". docs/04 §10.
  searchTerms           String[]           @map("search_terms")
  baseUnit              BaseUnit           @map("base_unit")
  defaultSaleUnit       SaleUnit           @map("default_sale_unit")
  perishability         PerishabilityClass
  defaultShelfLifeHours Int                @map("default_shelf_life_hours")
  imageKey              String?            @map("image_key")
  isActive              Boolean            @default(true) @map("is_active")

  category    ProductCategory  @relation(fields: [categoryId], references: [id])
  varieties   ProductVariety[]
  listings    Listing[]
  productions Production[]

  @@index([categoryId, isActive])
  @@map("products")
}

model ProductVariety {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  nameEn    String  @map("name_en")
  nameBn    String  @map("name_bn")
  isActive  Boolean @default(true) @map("is_active")

  product     Product      @relation(fields: [productId], references: [id])
  productions Production[]

  @@unique([productId, nameEn])
  @@map("product_varieties")
}

model Listing {
  id              String       @id @default(uuid()) @db.Uuid
  farmId          String       @map("farm_id") @db.Uuid
  farmerProfileId String       @map("farmer_profile_id") @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  varietyId       String?      @map("variety_id") @db.Uuid
  grade           QualityGrade @default(UNGRADED)
  title           String?
  description     String?

  saleUnit              String  @map("sale_unit")
  /// Base units in one sale unit: KG = 1_000_000 (mg), MON = 37_324_000. Exact, always.
  saleUnitInBaseUnits   BigInt  @map("sale_unit_in_base_units")
  /// Price per sale unit, integer poisha. Never a float.
  unitPricePoisha       BigInt  @map("unit_price_poisha")
  quantityTotalBase     BigInt  @map("quantity_total_base")
  quantityAvailableBase BigInt  @map("quantity_available_base")
  quantityReservedBase  BigInt  @default(0) @map("quantity_reserved_base")
  minOrderBase          BigInt  @default(0) @map("min_order_base")
  /// Whether a buyer wanting more than is held may take a partial fill. docs/04 §9.
  allowsPartialFill     Boolean @default(false) @map("allows_partial_fill")

  harvestedAt       DateTime? @map("harvested_at")
  expectedHarvestAt DateTime? @map("expected_harvest_at")
  availableFrom     DateTime  @map("available_from")
  availableTo       DateTime  @map("available_to")
  shelfLifeHours    Int?      @map("shelf_life_hours")

  /// Effective location — defaults from the farm, may be overridden for a collection point.
  latitude    Decimal?                               @db.Decimal(9, 6)
  longitude   Decimal?                               @db.Decimal(9, 6)
  adminAreaId String                                 @map("admin_area_id") @db.Uuid
  precision   LocationPrecision                      @default(AREA_CENTROID)
  /// Maintained by trigger from latitude/longitude; GIST-indexed for radius discovery.
  geo         Unsupported("geography(Point, 4326)")?

  offersPickup          Boolean @default(true) @map("offers_pickup")
  offersSellerDelivery  Boolean @default(false) @map("offers_seller_delivery")
  sellerDeliveryRadiusM Int?    @map("seller_delivery_radius_m")
  /// SELLER_FUNDED delivery requires this explicit opt-in. Langgol never assigns a cost to a
  /// farmer on their behalf. docs/04 §3.1 rule 3.
  offersFundedDelivery  Boolean @default(false) @map("offers_funded_delivery")

  status          String    @default("DRAFT")
  /// PRICE_OUTLIER | IMAGE_REVIEW | REPORTED — a soft signal for ops, never a silent block.
  moderationFlag  String?   @map("moderation_flag")
  publishedAt     DateTime? @map("published_at")
  /// May be an OPS_AGENT acting for the farmer.
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  farm         Farm                 @relation(fields: [farmId], references: [id])
  farmer       FarmerProfile        @relation(fields: [farmerProfileId], references: [id])
  product      Product              @relation(fields: [productId], references: [id])
  area         AdminArea            @relation(fields: [adminAreaId], references: [id])
  reservations ListingReservation[]

  @@index([status, availableTo])
  @@index([productId, status])
  @@index([farmerProfileId, status])
  @@index([adminAreaId, status])
  @@map("listings")
}

enum ReservationStatus {
  HELD
  COMMITTED
  RELEASED
  EXPIRED
}

/// Prevents overselling between "place order" and "farmer accepts".
///
/// Reserving at order placement rather than at add-to-cart is deliberate: reserving on
/// add-to-cart lets one idle browser lock a farmer's crop for hours. docs/04 §9.
model ListingReservation {
  id           String            @id @default(uuid()) @db.Uuid
  listingId    String            @map("listing_id") @db.Uuid
  orderId      String?           @map("order_id") @db.Uuid
  buyerUserId  String            @map("buyer_user_id") @db.Uuid
  quantityBase BigInt            @map("quantity_base")
  status       ReservationStatus @default(HELD)
  expiresAt    DateTime          @map("expires_at")
  releasedAt   DateTime?         @map("released_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([listingId, status])
  @@index([status, expiresAt])
  @@map("listing_reservations")
}

// ------------------------------------------------------------------------ quotes & orders

enum FulfilmentMode {
  BUYER_PICKUP
  SELLER_DELIVERY
  LANGGOL_DELIVERY
}

enum DeliveryFundingModel {
  /// Buyer pays the full tariff — the default. Decision D3.
  COST_RECOVERING
  /// Platform absorbs part; requires a SubsidyReason and budget headroom.
  PROMOTIONAL_SUBSIDY
  /// Platform absorbs all; requires a SubsidyReason and budget headroom.
  FREE_DELIVERY
  /// Retailer pays directly, often above tariff for priority.
  RETAILER_FUNDED
  /// Farmer absorbs it as a selling incentive. Requires listing opt-in.
  SELLER_FUNDED
  /// Split by an explicit ratio recorded on the order.
  SHARED
}

/// Server-authoritative price snapshot. The ONLY source of truth for what an order costs.
///
/// The client receives a quote **id**, never numbers. At checkout it submits the id; the server
/// reloads the quote, verifies ownership, expiry and single use, re-reads the listing, and copies
/// the money onto the order. There is no code path that reads a price from a request body.
/// docs/04 §8; docs/07_SECURITY.md §5
model OrderQuote {
  id                    String         @id @default(uuid()) @db.Uuid
  buyerUserId           String         @map("buyer_user_id") @db.Uuid
  sellerFarmerProfileId String         @map("seller_farmer_profile_id") @db.Uuid
  deliveryAddressId     String?        @map("delivery_address_id") @db.Uuid
  fulfilmentMode        FulfilmentMode @map("fulfilment_mode")

  /// [{ listingId, quantityBase, unitPricePoisha, lineTotalPoisha }]
  lines             Json
  subtotalPoisha    BigInt @map("subtotal_poisha")
  deliveryFeePoisha BigInt @default(0) @map("delivery_fee_poisha")
  handlingFeePoisha BigInt @default(0) @map("handling_fee_poisha")
  platformFeePoisha BigInt @default(0) @map("platform_fee_poisha")
  buyerTotalPoisha  BigInt @map("buyer_total_poisha")

  sellerGrossPoisha BigInt @map("seller_gross_poisha")
  commissionPoisha  BigInt @map("commission_poisha")
  commissionBps     Int    @map("commission_bps")
  sellerNetPoisha   BigInt @map("seller_net_poisha")

  /// The funding decision, frozen at quote time so checkout cannot change who pays.
  deliveryFundingModel           DeliveryFundingModel @default(COST_RECOVERING) @map("delivery_funding_model")
  deliveryTariffPoisha           BigInt               @default(0) @map("delivery_tariff_poisha")
  deliveryFundedBySellerPoisha   BigInt               @default(0) @map("delivery_funded_by_seller_poisha")
  deliveryFundedByRetailerPoisha BigInt               @default(0) @map("delivery_funded_by_retailer_poisha")
  promotionalSubsidyPoisha       BigInt               @default(0) @map("promotional_subsidy_poisha")
  /// Controlled vocabulary (docs/10 §9.3). A CHECK constraint enforces its presence.
  subsidyReason                  String?              @map("subsidy_reason")

  /// Modelled margin, stored on every quote so negative-margin orders are countable.
  contributionMarginPoisha BigInt @map("contribution_margin_poisha")
  expectedCostPoisha       BigInt @map("expected_cost_poisha")

  distanceMeters Int?    @map("distance_meters")
  /// HAVERSINE | HAVERSINE_CIRCUITY | ROAD_API — so the estimate's error can be measured.
  distanceSource String? @map("distance_source")

  /// The full explainable cost model output, including the buyer-facing breakdown.
  breakdown      Json
  paymentMethod  String? @map("payment_method")
  pricingVersion String  @map("pricing_version")
  /// Key → version for every config entry this price was computed under.
  configVersions Json    @map("config_versions")

  expiresAt         DateTime  @map("expires_at")
  consumedAt        DateTime? @map("consumed_at")
  consumedByOrderId String?   @unique @map("consumed_by_order_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  order Order?

  @@index([buyerUserId, createdAt])
  @@index([expiresAt])
  @@map("order_quotes")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  MFS
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum CancelledBy {
  BUYER
  SELLER
  SYSTEM
  ADMIN
}

/// WHO the cost of a failure is attributable to. Explicit in the domain model, never inferred.
enum FaultParty {
  BUYER
  SELLER
  PLATFORM
  LOGISTICS
  FORCE_MAJEURE
  UNDETERMINED
}

enum BuyerSegment {
  CONSUMER
  RETAILER
}

model Order {
  id                    String         @id @default(uuid()) @db.Uuid
  /// Human-readable, e.g. LG-260813-0A3F2.
  orderNumber           String         @unique @map("order_number")
  buyerUserId           String         @map("buyer_user_id") @db.Uuid
  sellerFarmerProfileId String         @map("seller_farmer_profile_id") @db.Uuid
  quoteId               String         @unique @map("quote_id") @db.Uuid
  status                OrderStatus    @default(PENDING)
  fulfilmentMode        FulfilmentMode @map("fulfilment_mode")
  buyerSegment          BuyerSegment   @map("buyer_segment")
  paymentMethod         PaymentMethod  @map("payment_method")
  paymentStatus         PaymentStatus  @default(UNPAID) @map("payment_status")

  /// Money — frozen at creation from the quote. Never recomputed from live listings.
  subtotalPoisha    BigInt @map("subtotal_poisha")
  deliveryFeePoisha BigInt @map("delivery_fee_poisha")
  handlingFeePoisha BigInt @map("handling_fee_poisha")
  platformFeePoisha BigInt @map("platform_fee_poisha")
  buyerTotalPoisha  BigInt @map("buyer_total_poisha")
  sellerGrossPoisha BigInt @map("seller_gross_poisha")
  commissionPoisha  BigInt @map("commission_poisha")
  /// The rate actually applied, frozen — a later rate change never rewrites history.
  commissionBps     Int    @map("commission_bps")
  sellerNetPoisha   BigInt @map("seller_net_poisha")
  currency          String @default("BDT")

  deliveryFundingModel           DeliveryFundingModel @default(COST_RECOVERING) @map("delivery_funding_model")
  deliveryTariffPoisha           BigInt               @default(0) @map("delivery_tariff_poisha")
  deliveryFundedBySellerPoisha   BigInt               @default(0) @map("delivery_funded_by_seller_poisha")
  deliveryFundedByRetailerPoisha BigInt               @default(0) @map("delivery_funded_by_retailer_poisha")
  promotionalSubsidyPoisha       BigInt               @default(0) @map("promotional_subsidy_poisha")
  subsidyReason                  String?              @map("subsidy_reason")
  subsidyApprovedById            String?              @map("subsidy_approved_by_id") @db.Uuid

  contributionMarginPoisha BigInt @map("contribution_margin_poisha")

  /// Mandatory on any non-happy terminal state — enforced by CHECK, not by a busy ops UI.
  faultParty FaultParty? @map("fault_party")
  faultNote  String?     @map("fault_note")

  cancellationFeePoisha           BigInt @default(0) @map("cancellation_fee_poisha")
  cancellationFeeToFarmerPoisha   BigInt @default(0) @map("cancellation_fee_to_farmer_poisha")
  cancellationFeeToPlatformPoisha BigInt @default(0) @map("cancellation_fee_to_platform_poisha")

  /// Delivery address snapshot — the address row may change later; the order must not.
  deliveryRecipientName  String?  @map("delivery_recipient_name")
  deliveryRecipientPhone String?  @map("delivery_recipient_phone")
  deliveryAddressLine    String?  @map("delivery_address_line")
  deliveryAreaId         String?  @map("delivery_area_id") @db.Uuid
  deliveryLatitude       Decimal? @map("delivery_latitude") @db.Decimal(9, 6)
  deliveryLongitude      Decimal? @map("delivery_longitude") @db.Decimal(9, 6)
  distanceMeters         Int?     @map("distance_meters")

  acceptanceDeadline DateTime     @map("acceptance_deadline")
  placedAt           DateTime     @default(now()) @map("placed_at")
  confirmedAt        DateTime?    @map("confirmed_at")
  readyAt            DateTime?    @map("ready_at")
  deliveredAt        DateTime?    @map("delivered_at")
  completedAt        DateTime?    @map("completed_at")
  cancelledAt        DateTime?    @map("cancelled_at")
  cancelledBy        CancelledBy? @map("cancelled_by")
  cancellationReason String?      @map("cancellation_reason")

  idempotencyKey String   @unique @map("idempotency_key")
  version        Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  quote        OrderQuote           @relation(fields: [quoteId], references: [id])
  items        OrderItem[]
  events       OrderEvent[]
  reservations ListingReservation[]
  delivery     Delivery?

  @@index([buyerUserId, status, placedAt])
  @@index([sellerFarmerProfileId, status, placedAt])
  @@index([status, acceptanceDeadline])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @map("order_id") @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// Snapshots — the listing can change or be deleted; the order is history.
  productNameEn       String       @map("product_name_en")
  productNameBn       String       @map("product_name_bn")
  varietyName         String?      @map("variety_name")
  grade               QualityGrade
  farmName            String       @map("farm_name")
  saleUnit            String       @map("sale_unit")
  saleUnitInBaseUnits BigInt       @map("sale_unit_in_base_units")
  unitPricePoisha     BigInt       @map("unit_price_poisha")
  quantityBase        BigInt       @map("quantity_base")
  lineTotalPoisha     BigInt       @map("line_total_poisha")
  harvestedAt         DateTime?    @map("harvested_at")

  /// Filled at fulfilment when actual weight differs — very common with fresh produce.
  deliveredQuantityBase BigInt? @map("delivered_quantity_base")
  adjustmentPoisha      BigInt? @map("adjustment_poisha")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([listingId])
  @@map("order_items")
}

/// Append-only. The order's status column is a projection of this log.
model OrderEvent {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  sequence    Int
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actorUserId String?      @map("actor_user_id") @db.Uuid
  actorRole   Role?        @map("actor_role")
  reason      String?
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, sequence])
  @@index([orderId, createdAt])
  @@map("order_events")
}

// ------------------------------------------------------------- delivery & trips
//
// docs/02_DATABASE.md §8, §8.1. Delivery cost is incurred per TRIP, not per order. If cost were
// only ever attached to an order, "did aggregating four orders reduce cost per order?" would be
// unanswerable, because there would be no record of the thing that was shared.

/// HOW the goods physically move — the unit of logistics experimentation. docs/04 §7.4.
enum DeliveryModel {
  /// One order, one dedicated trip. The honest worst case.
  INDIVIDUAL
  /// Several nearby orders on one route. Tests whether pooling actually reduces cost per order.
  AGGREGATED_ROUTE
  /// Farmer to retailer, typically one large drop.
  RETAILER_BULK
  /// Buyer collects. The floor: near-zero logistics cost to Langgol.
  PICKUP
}

enum DeliveryStatus {
  NOT_REQUIRED
  PENDING_ASSIGNMENT
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum AllocationMethod {
  WEIGHT_SHARE
  EQUAL_SHARE
  DISTANCE_WEIGHTED
  STANDALONE
}

model Delivery {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @unique @map("order_id") @db.Uuid
  mode          FulfilmentMode
  /// Experiment stratum. Every order is tagged with the model that actually moved the goods.
  deliveryModel DeliveryModel  @map("delivery_model")
  tripId        String?        @map("trip_id") @db.Uuid
  status        DeliveryStatus @default(PENDING_ASSIGNMENT)

  pickupDistanceMeters   Int?    @map("pickup_distance_meters")
  deliveryDistanceMeters Int?    @map("delivery_distance_meters")
  distanceMeters         Int?    @map("distance_meters")
  vehicleType            String? @map("vehicle_type")

  assignedOpsUserId String?   @map("assigned_ops_user_id") @db.Uuid
  courierName       String?   @map("courier_name")
  courierPhone      String?   @map("courier_phone")
  plannedPickupAt   DateTime? @map("planned_pickup_at")
  plannedDeliveryAt DateTime? @map("planned_delivery_at")
  pickedUpAt        DateTime? @map("picked_up_at")
  deliveredAt       DateTime? @map("delivered_at")
  failureReason     String?   @map("failure_reason")
  proofPhotoKey     String?   @map("proof_photo_key")
  deliveryOtpHash   String?   @map("delivery_otp_hash")

  /// This order's ALLOCATED share of its trip's actual cost — written by reconciliation, never
  /// by a human and never estimated. Null until the trip is costed. docs/02 §8.
  actualCostPoisha      BigInt?   @map("actual_cost_poisha")
  /// What the engine predicted at quote time, copied here so model-vs-reality is one subtraction.
  expectedCostPoisha    BigInt?   @map("expected_cost_poisha")
  /// thisOrderChargeableWeight / totalLoadedWeight, as an exact rational. docs/04 §4.
  allocationNumerator   BigInt?   @map("allocation_numerator")
  allocationDenominator BigInt?   @map("allocation_denominator")
  reconciledAt          DateTime? @map("reconciled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order         @relation(fields: [orderId], references: [id])
  trip  DeliveryTrip? @relation(fields: [tripId], references: [id])

  @@index([status, plannedDeliveryAt])
  @@index([tripId])
  @@map("deliveries")
}

/// One vehicle movement, carrying one or many orders. **Cost is recorded HERE.**
model DeliveryTrip {
  id                  String        @id @default(uuid()) @db.Uuid
  tripRef             String        @unique @map("trip_ref")
  deliveryModel       DeliveryModel @map("delivery_model")
  status              TripStatus    @default(PLANNED)
  vehicleType         String        @map("vehicle_type")
  /// Milligrams, matching the quantity base unit. docs/02 §6.1.
  vehicleCapacityBase BigInt        @map("vehicle_capacity_base")
  operatedByUserId    String?       @map("operated_by_user_id") @db.Uuid
  districtId          String?       @map("district_id") @db.Uuid

  plannedStartAt DateTime? @map("planned_start_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")

  pickupDistanceMeters   Int    @default(0) @map("pickup_distance_meters")
  deliveryDistanceMeters Int    @default(0) @map("delivery_distance_meters")
  /// Total including the unavoidable return leg.
  routeDistanceMeters    Int    @default(0) @map("route_distance_meters")
  /// What was actually carried, in milligrams.
  totalWeightBase        BigInt @default(0) @map("total_weight_base")
  orderCount             Int    @default(0) @map("order_count")

  /// Sum of cost items, entered by ops with a receipt or a documented standard rate.
  actualCostPoisha BigInt?          @map("actual_cost_poisha")
  costEvidenceKey  String?          @map("cost_evidence_key")
  allocationMethod AllocationMethod @default(WEIGHT_SHARE) @map("allocation_method")
  costedById       String?          @map("costed_by_id") @db.Uuid
  costedAt         DateTime?        @map("costed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stops      TripStop[]
  costItems  TripCostItem[]
  deliveries Delivery[]

  @@index([status, plannedStartAt])
  @@index([deliveryModel, completedAt])
  @@map("delivery_trips")
}

model TripStop {
  id       String @id @default(uuid()) @db.Uuid
  tripId   String @map("trip_id") @db.Uuid
  sequence Int
  /// PICKUP | DROP
  stopType String @map("stop_type")

  orderId           String?   @map("order_id") @db.Uuid
  farmId            String?   @map("farm_id") @db.Uuid
  latitude          Decimal?  @db.Decimal(9, 6)
  longitude         Decimal?  @db.Decimal(9, 6)
  legDistanceMeters Int?      @map("leg_distance_meters")
  weightBase        BigInt    @default(0) @map("weight_base")
  arrivedAt         DateTime? @map("arrived_at")
  completedAt       DateTime? @map("completed_at")

  trip DeliveryTrip @relation(fields: [tripId], references: [id])

  @@unique([tripId, sequence])
  @@index([orderId])
  @@map("trip_stops")
}

model TripCostItem {
  id             String   @id @default(uuid()) @db.Uuid
  tripId         String   @map("trip_id") @db.Uuid
  /// FUEL | VEHICLE_HIRE | DRIVER | TOLL | FERRY | LOADING | OTHER
  category       String
  amountPoisha   BigInt   @map("amount_poisha")
  /// True = an applied standard rate, not a receipt. Tells us how much cost data is OBSERVED
  /// rather than assumed — which is the difference between calibration and circular reasoning.
  isStandardRate Boolean  @default(false) @map("is_standard_rate")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  trip DeliveryTrip @relation(fields: [tripId], references: [id])

  @@index([tripId])
  @@map("trip_cost_items")
}

// ------------------------------------------------------------------------ ledger
//
// docs/06_FINANCIAL_ARCHITECTURE.md §3, §5. No balance is ever stored: a farmer's payable is
// SUM(credits) − SUM(debits) over account 2000/<farmerId>.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountOwnerType {
  PLATFORM
  FARMER
  BUYER
  AGENT
  PROVIDER
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

/// Per-farmer and per-agent accounts are created lazily from (code, ownerType, ownerId).
model LedgerAccount {
  id        String           @id @default(uuid()) @db.Uuid
  code      String
  name      String
  type      AccountType
  ownerType AccountOwnerType @map("owner_type")
  /// Null for a platform-owned account.
  ownerId   String?          @map("owner_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@unique([code, ownerId])
  @@index([code])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  /// Deterministic, derived from the business event: `ORDER:<id>:GOODS_DELIVERED`. The unique
  /// constraint makes a duplicate posting impossible even when the application layer is wrong.
  /// This is layer 2 of docs/06 §7, and it is the layer that actually protects the books.
  idempotencyKey String   @unique @map("idempotency_key")
  description    String
  /// ORDER | TRIP | SETTLEMENT | PAYMENT | REMITTANCE
  referenceType  String?  @map("reference_type")
  referenceId    String?  @map("reference_id")
  postedAt       DateTime @default(now()) @map("posted_at")
  createdAt      DateTime @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([postedAt])
  @@map("ledger_transactions")
}

/// Immutable by database RULE. Amounts are always positive; `direction` carries the sign.
model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  direction     LedgerDirection
  amountPoisha  BigInt          @map("amount_poisha")
  memo          String?
  createdAt     DateTime        @default(now()) @map("created_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}
