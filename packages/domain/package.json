    "./config": "./src/config/index.ts",
    "./identity": "./src/identity/index.ts",
    "./policy": "./src/policy/index.ts",
    "./notifications": "./src/notifications/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
