{
  "name": "@langgol/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure Langgol domain logic — no framework, no database, no I/O",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
